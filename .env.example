# Beispiel-Umgebungsvariablen für das Deployment (z. B. per Helm als ConfigMap/Secret).
# Kopieren nach .env und Werte anpassen. Die echte .env nicht einchecken.

# --- Anwendung ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=default

# --- ArangoDB (ConfigMap) ---
# Im Cluster typischerweise der Service-Name, z. B. arangodb.<namespace>.svc.cluster.local
ARANGODB_HOST=arangodb
ARANGODB_PORT=8529
ARANGODB_DATABASE=arrango

# --- ArangoDB-Zugangsdaten (Secret) ---
ARANGODB_USER=root
ARANGODB_PASSWORD=changeme

# --- Actuator / Probes ---
# Liveness:  /actuator/health/liveness
# Readiness: /actuator/health/readiness
MANAGEMENT_SERVER_PORT=8080
